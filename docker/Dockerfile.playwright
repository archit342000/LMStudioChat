# Using the official Playwright jammy image
FROM mcr.microsoft.com/playwright/python:v1.59.0-jammy

USER root

# Prevent interactive prompts during apt-get install (like tzdata)
ENV DEBIAN_FRONTEND=noninteractive

# Install X11, VNC, and Window Manager dependencies
RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    fluxbox \
    x11-utils \
    && rm -rf /var/lib/apt/lists/*

# Ensure X11 sockets directory exists with correct permissions
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Create user
RUN groupadd -r appgroup && useradd -r -g appgroup -m -d /app appuser

WORKDIR /app

# Install isolated dependencies
COPY playwright_mcp/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt



# Set ownership
RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8001 6080

CMD ["/app/playwright_mcp/entrypoint.sh"]